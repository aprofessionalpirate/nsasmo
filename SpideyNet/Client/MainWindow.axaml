<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpideyNet.Client.ViewModels"
        xmlns:game="using:SpideyNet.Game"
        x:Class="SpideyNet.Client.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainWindowViewModel"
        Title="SpideyNet · DOS multiplayer"
        Width="1080" Height="700" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#131822">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="2.5*,*" RowSpacing="14" ColumnSpacing="20">
      <StackPanel Grid.ColumnSpan="2" Spacing="4">
        <TextBlock Text="SPIDEYNET" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="VGA · DOS multiplayer" Foreground="#A8B6CA" />
      </StackPanel>

      <Border Grid.Row="1" Background="#1D2533" CornerRadius="10" Padding="20">
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="14" RowSpacing="10">
          <TextBlock Text="Relay address" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Endpoint}" IsEnabled="{Binding CanEdit}"
                   PlaceholderText="ws://localhost:5080" AutomationProperties.Name="Relay address" />
          <TextBlock Grid.Row="1" Text="Room key" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RoomKey}" IsEnabled="{Binding CanEdit}"
                   AutomationProperties.Name="Room key" />
          <TextBlock Grid.Row="2" Text="Your name" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PlayerName}" MaxLength="24"
                   IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Your name" />
          <TextBlock Grid.Row="3" Text="DOSBox" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                    IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" AutomationProperties.Name="DOSBox">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="game:GameProcess">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="4" Text="Rendering" VerticalAlignment="Center" />
          <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RenderingModes}" SelectedItem="{Binding Rendering}"
                    IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" AutomationProperties.Name="Rendering" />
          <TextBlock Grid.Row="5" Text="Player interactions" VerticalAlignment="Center" />
          <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding InteractionModes}" SelectedItem="{Binding Interactions}"
                    IsEnabled="{Binding CanConfigureWorld}" HorizontalAlignment="Stretch" AutomationProperties.Name="Player interactions" />
          <TextBlock Grid.Row="6" Text="Enemies / puzzles" VerticalAlignment="Center" />
          <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding SharedModes}" SelectedItem="{Binding Shared}"
                    IsEnabled="{Binding CanConfigureWorld}" HorizontalAlignment="Stretch" AutomationProperties.Name="Enemies and puzzles" />
        </Grid>
      </Border>

      <TextBlock Grid.Row="2" Text="Experimental rendering writes game memory. Space fires the native web; V freezes a nearby player."
                 TextWrapping="Wrap" Foreground="#E8BD79" FontSize="13" />

      <WrapPanel Grid.Row="3" Orientation="Horizontal">
        <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="primary" Margin="0,0,8,8" />
        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,8" />
        <Button Content="Refresh DOSBox" Command="{Binding RefreshGamesCommand}" Margin="0,0,8,8" />
        <Button Content="Copy room key" Command="{Binding CopyRoomKeyCommand}" Margin="0,0,8,8" />
        <Button Content="Fire web · V" Command="{Binding FireWebCommand}" Margin="0,0,0,8" />
      </WrapPanel>

      <StackPanel Grid.Row="4" Spacing="6">
        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" AutomationProperties.Name="Connection status" />
        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Foreground="#A8B6CA" />
        <Border IsVisible="{Binding HasError}" Background="#43252B" CornerRadius="6" Padding="12">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FFD4D8" />
        </Border>
      </StackPanel>

      <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" Background="#1D2533" CornerRadius="10" Padding="16" MinHeight="180">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="2*,*,*">
            <TextBlock Text="PLAYER" FontWeight="SemiBold" Foreground="#A8B6CA" />
            <TextBlock Grid.Column="1" Text="ROOM" FontWeight="SemiBold" Foreground="#A8B6CA" />
            <TextBlock Grid.Column="2" Text="POSITION" FontWeight="SemiBold" Foreground="#A8B6CA" />
          </Grid>
          <TextBlock Grid.Row="1" Text="Other players appear here when they join your room."
                     IsVisible="{Binding !HasPlayers}" TextWrapping="Wrap" Foreground="#A8B6CA" />
          <ScrollViewer Grid.Row="1" IsVisible="{Binding HasPlayers}">
            <ItemsControl ItemsSource="{Binding Players}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerViewModel">
                  <Grid ColumnDefinitions="2*,*,*" Margin="0,7">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Room}" />
                    <TextBlock Grid.Column="2" Text="{Binding Position}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
