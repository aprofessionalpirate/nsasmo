<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpideyNet.Client.ViewModels"
        xmlns:game="using:SpideyNet.Game"
        x:Class="SpideyNet.Client.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainWindowViewModel"
        Title="SpideyNet"
        Width="1220" Height="820" MinWidth="1000" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#131822">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="1.15*,*" RowSpacing="14" ColumnSpacing="20">
      <StackPanel Grid.ColumnSpan="2" Spacing="4">
        <TextBlock Text="SPIDEYNET" FontSize="30" FontWeight="Bold" />
      </StackPanel>

      <Border Grid.Row="1" Background="#1D2533" CornerRadius="10" Padding="20">
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="14" RowSpacing="10">
          <TextBlock Text="Relay address" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Endpoint}" IsEnabled="{Binding CanEdit}"
                   PlaceholderText="ws://localhost:5080" AutomationProperties.Name="Relay address" />
          <TextBlock Grid.Row="1" Text="Room key" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RoomKey}" IsEnabled="{Binding CanEdit}"
                   AutomationProperties.Name="Room key" />
          <TextBlock Grid.Row="2" Text="Your name" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PlayerName}" MaxLength="24"
                   IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Your name" />
          <TextBlock Grid.Row="3" Text="DOSBox" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                    IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" AutomationProperties.Name="DOSBox">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="game:GameProcess">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="4" Text="Rendering" VerticalAlignment="Center" />
          <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RenderingModes}" SelectedItem="{Binding Rendering}"
                    IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" AutomationProperties.Name="Rendering" />
          <TextBlock Grid.Row="5" Text="Player interactions" VerticalAlignment="Center" />
          <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding InteractionModes}" SelectedItem="{Binding Interactions}"
                    IsEnabled="{Binding CanConfigureWorld}" HorizontalAlignment="Stretch" AutomationProperties.Name="Player interactions" />
          <TextBlock Grid.Row="6" Text="Enemies / puzzles" VerticalAlignment="Center" />
          <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding SharedModes}" SelectedItem="{Binding Shared}"
                    IsEnabled="{Binding CanConfigureWorld}" HorizontalAlignment="Stretch" AutomationProperties.Name="Enemies and puzzles" />
          <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Show chosen Spidey colours (including yours)"
                    IsChecked="{Binding DifferentColours}" IsEnabled="{Binding CanConfigureWorld}"
                    AutomationProperties.Name="Different player colours" />
          <TextBlock Grid.Row="8" Text="Your Spidey colour" VerticalAlignment="Center" />
          <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding SuitColours}" SelectedItem="{Binding Colour}"
                    IsEnabled="{Binding CanChooseColour}" HorizontalAlignment="Stretch" AutomationProperties.Name="Your Spidey colour" />
          <TextBlock Grid.Row="9" Text="Your sprite" VerticalAlignment="Center" />
          <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Sprites}" SelectedItem="{Binding SelectedSprite}"
                    IsEnabled="{Binding CanConfigureWorld}" HorizontalAlignment="Stretch" AutomationProperties.Name="Your sprite">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpriteChoice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>

      <TextBlock Grid.Row="2" Text="Experimental rendering writes game memory."
                 TextWrapping="Wrap" Foreground="#E8BD79" FontSize="13" />

      <WrapPanel Grid.Row="3" Orientation="Horizontal">
        <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="primary" Margin="0,0,8,8" />
        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,8" />
        <Button Content="Refresh DOSBox" Command="{Binding RefreshGamesCommand}" Margin="0,0,8,8" />
        <Button Content="Copy room key" Command="{Binding CopyRoomKeyCommand}" Margin="0,0,8,8" />
        <Button Content="Push player · V" Command="{Binding PushPlayerCommand}" Margin="0,0,0,8" />
      </WrapPanel>

      <StackPanel Grid.Row="4" Spacing="6">
        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" AutomationProperties.Name="Connection status" />
        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Foreground="#A8B6CA" />
        <Border IsVisible="{Binding HasError}" Background="#43252B" CornerRadius="6" Padding="12">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FFD4D8" />
        </Border>
      </StackPanel>

      <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" Background="#1D2533" CornerRadius="10" Padding="16" MinHeight="180">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="2*,2*,*,*" ColumnSpacing="8">
            <TextBlock Text="PLAYER" FontWeight="SemiBold" Foreground="#A8B6CA" />
            <TextBlock Grid.Column="1" Text="ROOM" FontWeight="SemiBold" Foreground="#A8B6CA" />
            <TextBlock Grid.Column="2" Text="POSITION" FontWeight="SemiBold" Foreground="#A8B6CA" />
            <TextBlock Grid.Column="3" Text="HEALTH" FontWeight="SemiBold" Foreground="#A8B6CA" />
          </Grid>
          <TextBlock Grid.Row="1" Text="Other players appear here when they join your room."
                     IsVisible="{Binding !HasPlayers}" TextWrapping="Wrap" Foreground="#A8B6CA" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                   IsVisible="{Binding HasPlayers}" MaxHeight="220"
                   AutomationProperties.Name="Other players">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlayerViewModel">
                <Grid ColumnDefinitions="2*,2*,*,*" ColumnSpacing="8" Margin="0,7">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Room}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{Binding Position}" />
                  <TextBlock Grid.Column="3" Text="{Binding Health}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="2">
            <Button Content="Teleport to player" Command="{Binding TeleportCommand}" Margin="0,0,8,8" />
            <Button Content="Spy" Command="{Binding SpyCommand}" Margin="0,0,8,8" />
            <Button Content="Stop spying" Command="{Binding StopSpyingCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Grid.Row="3" Text="{Binding PreviewStatus}" TextWrapping="Wrap" Foreground="#A8B6CA" />
          <StackPanel Grid.Row="5" Spacing="8">
            <TextBlock Text="TAUNTS" FontWeight="SemiBold" Foreground="#A8B6CA" />
            <ComboBox ItemsSource="{Binding Taunts}" SelectedItem="{Binding SelectedTaunt}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Taunt selector">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TauntChoice">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <WrapPanel>
              <Button Content="Preview taunt" Command="{Binding PreviewTauntCommand}" Margin="0,0,8,8" />
              <Button Content="Send taunt" Command="{Binding SendTauntCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <CheckBox Content="Hear multiplayer taunts" IsChecked="{Binding HearTaunts}" />
            <TextBlock Text="{Binding TauntStatus}" TextWrapping="Wrap" Foreground="#A8B6CA" />
          </StackPanel>
          <Border Grid.Row="4" IsVisible="{Binding IsSpying}" Background="Black" CornerRadius="4" Padding="4">
            <Image Source="{Binding Preview}" Height="250" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="Player game preview" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
